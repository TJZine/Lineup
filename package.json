{
    "name": "lineup",
    "version": "1.0.0",
    "description": "webOS Plex Virtual Channels Application",
    "author": "TJZine",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/TJZine/Lineup.git"
    },
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run build:dev",
        "build:lean": "cross-env LINEUP_BUILD_PROFILE=lean vite build",
        "build:dev": "cross-env LINEUP_BUILD_PROFILE=dev vite build",
        "build:analyze": "cross-env LINEUP_BUILD_PROFILE=lean ANALYZE=1 vite build",
        "build:analyze:dev": "cross-env LINEUP_BUILD_PROFILE=dev ANALYZE=1 vite build",
        "preview": "vite preview --port 5173",
        "build:ts": "tsc",
        "lint": "eslint src",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
        "lint:fix": "eslint src --fix",
        "test": "jest --config jest.config.js",
        "test:watch": "jest --config jest.config.js --watch",
        "test:coverage": "jest --config jest.config.js --coverage",
        "test:contracts": "jest --config jest.contracts.config.js --runInBand",
        "test:all": "npm test && npm run test:contracts",
        "test:timings": "jest --config jest.config.js --runInBand --json --outputFile /tmp/retune-jest-results.json && node scripts/jest-report-slowest.mjs /tmp/retune-jest-results.json",
        "typecheck": "tsc --noEmit",
        "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run test:all && npm run build",
        "verify:quick": "npm run typecheck && npm run test:all",
        "package:webos": "npm run build:lean && ares-package dist/"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "@types/qrcode": "^1.5.6",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.55.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.0.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "rollup-plugin-visualizer": "^6.0.5",
        "stylelint": "^16.0.0",
        "stylelint-config-standard": "^37.0.0",
        "ts-jest": "^29.4.5",
        "typescript": "^5.3.3",
        "vite": "^7.3.1"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "keywords": [
        "webos",
        "plex",
        "tv",
        "channels",
        "streaming",
        "typescript"
    ],
    "dependencies": {
        "qrcode": "^1.5.4"
    }
}
